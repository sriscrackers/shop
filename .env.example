# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Environment
NODE_ENV="development"

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET="" # Generated by create-t3-app.

# Drizzle
DATABASE_URL=""

# UploadThing
UPLOADTHING_TOKEN=''

# Initial Admin Seed Script
# Used only by the one-off seed script, never read at runtime
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME=""